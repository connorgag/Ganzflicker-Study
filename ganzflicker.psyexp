        <Param val="thank_you_text = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: &quot;Thank you! I hope you enjoyed your experience.\nWait for the researcher, they should be back in a second.&quot;, &quot;height&quot;: 0.05, &quot;color&quot;: &quot;black&quot;, &quot;bold&quot;: false, &quot;alignText&quot;: &quot;center&quot;, &quot;anchorHoriz&quot;: &quot;center&quot;, &quot;wrapWidth&quot;: 1.6, &quot;pos&quot;: [0, 0]});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
