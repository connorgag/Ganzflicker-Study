        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Main body of text&amp;#10;warning_intro = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=&quot;If at any time, the Ganzflicker becomes highly unpleasant for you, you are not obligated to continue.&quot;,&amp;#10;    height=0.04,&amp;#10;    color=&quot;black&quot;,&amp;#10;    alignText='left',&amp;#10;    anchorHoriz='left',&amp;#10;    wrapWidth=1.6,&amp;#10;    pos=(-0.8, 0.35)&amp;#10;)&amp;#10;&amp;#10;# RED warning text&amp;#10;warning_red = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=&quot;Warning: Do not continue the study if you have photosensitive epilepsy!\nLet the researcher know and we will finish the study here.&quot;,&amp;#10;    height=0.045,&amp;#10;    color=&quot;red&quot;,&amp;#10;    bold=True,&amp;#10;    alignText='left',&amp;#10;    anchorHoriz='left',&amp;#10;    wrapWidth=1.6,&amp;#10;    pos=(-0.8, 0.2)&amp;#10;)&amp;#10;&amp;#10;# Final instruction&amp;#10;warning_final = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text='When you press ENTER the Ganzflicker experience will immediately start',&amp;#10;    height=0.04,&amp;#10;    color=&quot;black&quot;,&amp;#10;    bold=True,&amp;#10;    alignText='left',&amp;#10;    anchorHoriz='left',&amp;#10;    wrapWidth=1.6,&amp;#10;    pos=(-0.8, 0.05)&amp;#10;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="warning_intro.draw()&amp;#10;warning_red.draw()&amp;#10;warning_final.draw()&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
