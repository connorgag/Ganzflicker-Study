      <CodeComponent name="flicker_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="flicker_freq = 7.5;&amp;#10;flicker_period = (1 / flicker_freq);&amp;#10;flicker_color = &quot;red&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Initialize flicker variables&amp;#10;flicker_color = 'red'  # Initial flicker state&amp;#10;flicker_freq = 7.5     # Flicker frequency in Hz&amp;#10;frameN = 0&amp;#10;frame_count = 0&amp;#10;&amp;#10;# Calculate how many frames per half-cycle (red/black)&amp;#10;frames_per_half_cycle = round(expInfo['frameRate'] / (2 * flicker_freq))&amp;#10;&amp;#10;# Clear keyboard buffer to prevent carryover keypresses&amp;#10;event.clearEvents()&amp;#10;hallucination_key.clearEvents()  # Specifically clear that key component&amp;#10;&amp;#10;# Mark when flicker starts (for logging hallucination timing)&amp;#10;flicker_start_time = globalClock.getTime()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Flicker logic&amp;#10;frameN += 1&amp;#10;frame_count += 1&amp;#10;&amp;#10;if (frame_count // frames_per_half_cycle) % 2 == 0:&amp;#10;    flicker_color = 'red'&amp;#10;else:&amp;#10;    flicker_color = 'black'&amp;#10;&amp;#10;# Log hallucination keypresses only&amp;#10;keys = hallucination_key.getKeys(clear=True)&amp;#10;for k in keys:&amp;#10;    if k.name == 'escape':&amp;#10;        core.quit()  # Immediately exit if escape is pressed&amp;#10;    elif k.name == 'space':&amp;#10;        if eyetracking == 1:&amp;#10;            el_tracker.sendMessage('hallucination y')&amp;#10;        thisExp.addData('key', k.name)&amp;#10;        thisExp.addData('press_time', globalClock.getTime())&amp;#10;        thisExp.addData('time_since_flicker_start', globalClock.getTime() - flicker_start_time)&amp;#10;        thisExp.nextEntry()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="flicker_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
